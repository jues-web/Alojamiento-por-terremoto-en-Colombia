PORT=3000
NODE_ENV=production

# PostgreSQL. En producción es OBLIGATORIA: si falta o falla la conexión, la app
# ya no cae silenciosamente a SQLite (perdería los datos en cada reinicio) — falla al arrancar.
# Local con docker compose: postgresql://postgres:postgres@db:5432/alojamiento_db
# Neon / proveedor externo: añadir ?sslmode=require al final.
DATABASE_URL=postgresql://postgres:postgres@db:5432/alojamiento_db

# Clave del panel de administración (puede eliminar cualquier registro).
# En producción debe tener 12+ caracteres y no puede ser un valor conocido como "admin123".
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_PASSWORD=cambia-esta-clave-antes-de-desplegar
