# ─────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir .env al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────

# Servidor
PORT=3000
NODE_ENV=production

# Base de datos (Railway genera DATABASE_URL automáticamente)
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:5432/alojamiento_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION
POSTGRES_DB=alojamiento_db

# Seguridad — CAMBIAR OBLIGATORIAMENTE antes de producción
ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA
