# ─────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir .env al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────

# Servidor
PORT=3000
NODE_ENV=production

# ─── Base de datos ───────────────────────────
# PostgreSQL es el ÚNICO motor soportado (ADR-009). DATABASE_URL es obligatoria
# siempre, también en desarrollo: sin ella la app no arranca.
# Railway/Render/Fly la generan automáticamente.
#   · Local con docker compose : postgresql://postgres:postgres@db:5432/alojamiento_db
#   · Local fuera de compose   : postgresql://postgres:postgres@localhost:5432/alojamiento_db
#   · Neon o gestionado        : añadir ?sslmode=require al final
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/alojamiento_db

# Solo los usa el contenedor `db` de docker-compose (desarrollo local).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION
POSTGRES_DB=alojamiento_db

# ─── Seguridad ───────────────────────────────
# Clave del panel de administración: permite eliminar cualquier registro.
# CAMBIAR OBLIGATORIAMENTE antes de producción. La app rechaza el arranque con
# NODE_ENV=production si falta, mide menos de 12 caracteres o es una clave débil
# conocida (admin123, password, changeme...).
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA
